# Configuration de l'API

# Mode API: 'mock' ou 'http'
# - mock: utilise des données mockées locales (pas de backend nécessaire)
# - http: appelle le vrai backend
VITE_API_MODE=mock

# URL du backend (utilisé uniquement en mode 'http')
VITE_API_URL=http://localhost:3000

# Tenant ID pour le multi-tenancy
VITE_TENANT_ID=default-tenant
