# Configuration de l'API (contrat v2 : src/domain, src/api, src/mocks)

# Mode API : 'mock' (MSW intercepte toutes les routes /api/*, aucun backend
# requis ; compte de demo alex.rivera@example.com / demo1234) ou 'http'
# (appelle le vrai backend). Voir docs/v2/API-ROUTES.md.
VITE_API_MODE=mock

# URL du backend (mode 'http' uniquement).
VITE_API_URL=http://localhost:3000

# Desactive la latence simulee des handlers MSW (~200-400ms par defaut).
# VITE_MOCK_DELAY=off
