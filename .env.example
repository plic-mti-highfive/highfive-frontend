# Configuration de l'API

# Mode API: 'mock' ou 'http'
# - mock: utilise des données mockées locales (pas de backend nécessaire)
# - http: appelle le vrai backend
VITE_API_MODE=mock

# URL du backend (utilisé uniquement en mode 'http')
VITE_API_URL=http://localhost:3000

# Tenant ID pour le multi-tenancy
VITE_TENANT_ID=default-tenant

# Contrat v2 (src/domain, src/api, src/mocks) : reutilise VITE_API_MODE et
# VITE_API_URL ci-dessus. En mode mock, MSW intercepte toutes les routes
# /api/* et le compte de demo est alex.rivera@example.com / demo1234
# (voir docs/v2/API-ROUTES.md).

# Desactive la latence simulee des handlers MSW (~200-400ms par defaut).
# VITE_MOCK_DELAY=off
